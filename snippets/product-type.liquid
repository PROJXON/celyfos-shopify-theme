<a class="collection-card" href="{{ url }}">
  <h2 class="text-center text-2xl uppercase font-bold">{{ title }}</h2>
  
  <div>
    {% if image != blank %}
      {% render 'image',
        image: image,
        width: 600,
        height: 600,
        crop: 'center'
      %}
    {% endif %}
  </div>

  {% if description != blank %}
    <p>{{ description | strip_html | truncatewords: 15 }}</p>
  {% endif %}
</a>