{% doc %}
  Wraps policy tiles in the shared tile grid layout.

  @param {string} content - Grid body HTML (usually from a `capture` of policy-tile snippets)

  @example
  {% capture tiles %}
    {% render 'policy-tile', label: 'Return window', val: '21 days from delivery' %}
  {% endcapture %}
  {% render 'policy-tile-grid', content: tiles %}
{% enddoc %}

<div class="policy-tile-grid grid grid-cols-[repeat(2,_1fr)] gap-[14px] !mb-[24px]">
  {{ content }}
</div>

{% stylesheet %}
  @media (max-width: 640px) {
    .policy-tile-grid {
      grid-template-columns: 1fr;
    }
    .policy-row {
      flex-direction: column;
      gap: 4px;
    }
    .policy-row__val { text-align: left; }
  }
{% endstylesheet %}