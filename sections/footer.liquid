<footer class="site-footer border-t border-[#E0D6CA] bg-[#F7F0E8] px-[32px] py-[32px]">
  <div class="mx-auto grid max-w-[1100px] grid-cols-1 gap-[24px] sm:grid-cols-2 md:grid-cols-3">
    <div class="footer-col">
      <h4 class="mb-[10px] font-['Playfair_Display'] text-[13px] font-semibold uppercase tracking-[0.08em] text-[#4A2E12]">{{ 'footer.navigate' | t }}</h4>
      <ul class="list-none">
        {% for link in section.settings.footer_menu.links %}
          <li class="mb-[5px]">
            <a href="{{ link.url }}" class="text-[12.5px] text-[#555555] no-underline hover:text-[#4A2E12] hover:no-underline">{{ link.title }}</a>
          </li>
        {% endfor %}
      </ul>
    </div>

    <div class="footer-col">
      <h4 class="mb-[10px] font-['Playfair_Display'] text-[13px] font-semibold uppercase tracking-[0.08em] text-[#4A2E12]">{{ 'footer.elsewhere' | t }}</h4>
      <ul class="list-none">
        {% unless settings.facebook == blank %}
          <li class="mb-[5px]">
            <a href="{{ settings.facebook }}" target="_blank" rel="noopener" class="text-[12.5px] text-[#555555] no-underline hover:text-[#4A2E12] hover:no-underline">Facebook</a>
          </li>
        {% endunless %}
        {% unless settings.instagram == blank %}
          <li class="mb-[5px]">
            <a href="{{ settings.instagram }}" target="_blank" rel="noopener" class="text-[12.5px] text-[#555555] no-underline hover:text-[#4A2E12] hover:no-underline">Instagram</a>
          </li>
        {% endunless %}
      </ul>
    </div>

    <div class="footer-col">
      <h4 class="mb-[10px] font-['Playfair_Display'] text-[13px] font-semibold uppercase tracking-[0.08em] text-[#4A2E12]">{{ shop.name }}®</h4>
      <ul class="list-none">
        <li class="mb-[5px]">
          <span class="text-[12.5px] text-[#555555]">{{ 'footer.established' | t }}</span>
        </li>
        {% unless section.settings.email == blank %}
          <li class="mb-[5px]">
            <a href="mailto:{{ section.settings.email }}" class="text-[12.5px] text-[#555555] no-underline hover:text-[#4A2E12] hover:no-underline">{{ section.settings.email }}</a>
          </li>
        {% endunless %}
      </ul>
    </div>
  </div>

  <div class="mx-auto mt-[20px] flex max-w-[1100px] flex-col justify-between gap-[8px] border-t border-[#E0D6CA] pt-[16px] text-[11px] text-[#888888] sm:flex-row">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name }} · {{ 'footer.rights' | t }}</span>
    <span>{{ 'footer.powered_by' | t }}</span>
  </div>
</footer>

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "link_list",
      "id": "footer_menu",
      "label": "t:labels.footer_menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "email",
      "label": "t:labels.email",
      "default": "info@celyfos.com"
    }
  ]
}
{% endschema %}
