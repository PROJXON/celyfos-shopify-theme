<footer class='w-full bg-[#F7F0E8] border-t-[0.5px] border-t-[#E0D6CA] font-[Lato] font-light m-0 p-0'>
  {%- comment -%} Value badges {%- endcomment -%}
  <div class='flex justify-center gap-[12px] md:gap-[32px] flex-wrap py-[24px] px-[32px] border-b-[0.5px] border-b-[#E0D6CA] flex-col md:flex-row items-center md:items-start'>
    {% render 'footer-badge', text: 'Engineered by an Aviation Engineer' %}
    {% render 'footer-badge', text: '100% Hand-made in Athens' %}
    {% render 'footer-badge', text: 'My Lifetime Guarantee' %}
  </div>

  {%- comment -%} Columns {%- endcomment -%}
  {%- capture follow_us_lines -%}
    Facebook|https://www.facebook.com/celyfos|blank
    Instagram|https://www.instagram.com/celyfos|blank
  {%- endcapture -%}
  {%- assign follow_us_items = follow_us_lines | strip | split: '
' -%}

  {%- capture celyfos_lines -%}
    Est. 2014 · Athens, Greece
    {{ section.settings.email }}|mailto:{{ section.settings.email }}
  {%- endcapture -%}
  {%- assign celyfos_items = celyfos_lines | strip | split: '
' -%}

  <div class='grid grid-cols-[1fr] md:grid-cols-[1.2fr_1fr_1.2fr] gap-[24px] md:gap-[32px] py-[28px] px-[32px] text-center md:text-left'>
    {% render 'footer-col', heading: section.settings.footer_menu.title, items: section.settings.footer_menu.links %}
    {% render 'footer-col', heading: 'Follow Us', items: follow_us_items %}
    {% render 'footer-col', heading: 'CELYFOS®', items: celyfos_items %}
  </div>

  {%- comment -%} Bottom bar {%- endcomment -%}
  <div class='flex justify-between items-center py-[14px] px-[32px] bt-[0.5px] bt-[#E0D6CA] text-[11px] text-[#888888]'>
    <span>&copy; {{ 'now' | date: '%Y' }} Celyfos
      &middot; All rights reserved</span>
    <span>Built by PROJXON</span>
  </div>
</footer>

{% stylesheet %}
/* Hide Shopify branding */
.footer__powered-by,
.shopify-section--footer-powered-by {
  display: none !important;
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "link_list",
      "id": "footer_menu",
      "label": "t:labels.footer_menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "email",
      "label": "t:labels.email",
      "default": "info@celyfos.com"
    }
  ]
}
{% endschema %}
