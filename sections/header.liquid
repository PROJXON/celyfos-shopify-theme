<header class="site-nav sticky top-0 flex h-[64px] items-center justify-between border-b border-[#E0D6CA] bg-white px-[18px] md:px-[32px]">
  <a href="{{ routes.root_url }}" class="font-['Playfair_Display'] text-[22px] font-semibold tracking-[0.04em] text-[#4A2E12] no-underline hover:no-underline">
    {{ shop.name }}
  </a>

  <ul class="flex list-none gap-[16px] text-[11px] font-normal uppercase tracking-[0.06em] text-[#555555] md:gap-[28px] md:text-[13px]">
    {% for link in section.settings.sections.links %}
      <li>
        <a href="{{ link.url }}" class="no-underline hover:text-[#4A2E12] hover:no-underline">{{ link.title }}</a>
      </li>
    {% endfor %}
  </ul>
</header>

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "sections",
      "label": "t:labels.sections",
      "default": "main-menu"
    }
  ]
}
{% endschema %}

{% stylesheet %}
  div.shopify-section-group-header-group {
    display: block;
  }
{% endstylesheet %}