{% comment %}
  This section is used in the list-collections template to render a list of
  collections.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<h1 class="topHeader">{{ 'collections.title' | t }}</h1>

<div
  class="collections {{ section.settings.grid_item_width }}"
  style="--grid-gap: {{ section.settings.grid_gap }}px"
>
  {% for collection in collections %}
    {% assign image = collection.featured_image %}
    {% render 'product-type',
      image: image,
      url: collection.url,
      title: collection.title,
      description: collection.description
    %}
  {% endfor %}
</div>

{% stylesheet %}
  .collections {
    --min-col: var(--collection-card-size, 280px);
    --gap: var(--grid-gap, 10px);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap);
    margin-bottom: 2rem;
  }
  .collections--compact {
    --collection-card-size: 160px;
  }
  .collections--full {
    --collection-card-size: 280px;
  }
  .collections > * {
    box-sizing: border-box;
    flex: 1 1 var(--min-col);
    max-width: min(100%, var(--min-col));
  }
  .collection-card {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  @supports (width: round(down, 1px)) and (width: 1cqi) {
    .collections {
      container-type: inline-size;
    }

    .collections > * {
      --cols: Max(1, round(down, (100cqi + var(--gap)) / (var(--min-col) + var(--gap))));
      flex: 0 0 min(100%, calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols)));
      max-width: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    {
      "type": "select",
      "id": "grid_item_width",
      "label": "t:labels.grid_item_width",
      "options": [
        { "value": "collections--compact", "label": "t:options.size.small" },
        { "value": "collections--full", "label": "t:options.size.large" }
      ],
      "default": "collections--full"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:labels.grid_gap",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [{ "name": "t:general.collections_grid" }]
}
{% endschema %}
