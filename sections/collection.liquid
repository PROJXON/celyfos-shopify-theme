{% liquid
  assign available_options = collection.metafields.custom.available_options.value
  assign selected_option = ''

  for filter in collection.filters
    if filter.param_name == 'filter.p.m.custom.option'
      for value in filter.values
        if value.active
          assign selected_option = value.label
        endif
      endfor
    endif
  endfor
%}

<section>
  {% if selected_option != blank %}
    <h1 class="topHeader">{{ collection.title }} - {{ selected_option }}</h1>
  {% else %}
    <h1 class="topHeader">{{ collection.title }}</h1>
  {% endif %}

  {% if available_options != blank %}
    {% if selected_option == blank %}
      <div
        class="collections collections--full"
        style="--grid-gap: 10px"
      >
        {% for option in available_options %}

          {% assign option_image = nil %}
          {% for product in collection.products %}
            {% assign product_option = product.metafields.custom.option.value %}

            {% if product_option and product_option.name == option.name %}
              {% assign option_image = product.featured_image %}
              {% break %}
            {% endif %}
          {% endfor %}

          {% for filter in collection.filters %}
            {% if filter.param_name == 'filter.p.m.custom.option' %}
              {% for value in filter.values %}
                {% if value.label == option.name %}
                  {% render 'product-type',
                    url: value.url_to_add,
                    title: option.name,
                    image: option_image
                  %}
                {% endif %}
              {% endfor %}
            {% endif %}
          {% endfor %}
        {% endfor %}
      </div>
    
    {% else %}
      {%- comment -%} An option is selected — show filtered products + back link {%- endcomment -%}
      <div class="!mb-4 font-bold">
        <a class="font-['Lato',_system-ui,_sans-serif] text-[12px] text-[#555555] tracking-[0.04em]" href="{{ collection.url }}">&larr; All {{ collection.title }}</a>
      </div>

      {% paginate collection.products by 20 %}
        {% render 'product-grid', items: collection.products %}
        {% render 'pagination', paginate: paginate %}
      {% endpaginate %}

    {% endif %}

  {% else %}
    {% paginate collection.products by 20 %}
      {% render 'product-grid', items: collection.products %}
      {% render 'pagination', paginate: paginate %}
    {% endpaginate %}
  {% endif %}
</section>

{% stylesheet %}
  .collections {
    --min-col: var(--collection-card-size, 280px);
    --gap: var(--grid-gap, 10px);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap);
    margin-bottom: 2rem;
  }
  .collections--compact {
    --collection-card-size: 160px;
  }
  .collections--full {
    --collection-card-size: 280px;
  }
  .collections > * {
    box-sizing: border-box;
    flex: 1 1 var(--min-col);
    max-width: min(100%, var(--min-col));
  }

  @supports (width: round(down, 1px)) and (width: 1cqi) {
    .collections {
      container-type: inline-size;
    }

    .collections > * {
      --cols: Max(1, round(down, (100cqi + var(--gap)) / (var(--min-col) + var(--gap))));
      flex: 0 0 min(100%, calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols)));
      max-width: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection",
  "settings": [],
  "presets": [{"name": "Collection"}]
}
{% endschema %}